NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ---------- Embedded Signup (feature-flagged OFF) ----------
# Only matters when the backend's EMBEDDED_SIGNUP_ENABLED is also true AND
# your Meta app has been approved for whatsapp_business_management +
# whatsapp_business_messaging via App Review.
#
# These values come from the Meta app dashboard once Embedded Signup is
# configured — see README for the step-by-step.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIGURATION_ID=
NEXT_PUBLIC_META_GRAPH_API_VERSION=v20.0
